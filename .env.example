# Optional: only investigate uses these settings. Never commit real credentials.
OPENROUTER_API_KEY=
# Set to an OpenRouter model ID that supports tool calling.
OPENROUTER_MODEL=

# Local FastAPI backend and Next.js server must share this credential (32+ chars).
# Prefer: python scripts/configure_local.py (creates ignored .env.api).
PATCHPROOF_API_TOKEN=
# Optional server-only fixture exception. Disabled when empty.
# Example: http://127.0.0.1:8765 — literal loopback IP, exact scheme and port.
PATCHPROOF_FIXTURE_ORIGIN=

# Backend only: default is relative to the backend working directory.
PATCHPROOF_DB_PATH=.patchproof/history.sqlite3

# Optional backend-only browser settings. Browser scanning currently requires macOS.
# Default: Playwright-managed Chromium. May point to an installed Chromium/Chrome.
PATCHPROOF_CHROMIUM_EXECUTABLE=
# Optional PEM trust bundle for browser broker HTTPS fixtures (TLS stays verified).
PATCHPROOF_BROWSER_CA_FILE=
# For baseline HTTP fixture trust, export SSL_CERT_FILE in the backend terminal.

# Hosted deployment: copy to .env.production and configure externally.
# Never use the local shared API token for hosted authentication.
PATCHPROOF_MODE=local
PATCHPROOF_DATABASE_URL=postgresql+psycopg://patchproof:REPLACE_URL_ENCODED_PASSWORD@postgres:5432/patchproof
POSTGRES_PASSWORD=REPLACE_WITH_MIGRATION_OWNER_PASSWORD
PATCHPROOF_APP_DB_PASSWORD=REPLACE_WITH_RUNTIME_DATABASE_PASSWORD
PATCHPROOF_MIGRATION_DATABASE_URL=postgresql+psycopg://patchproof_migrator:REPLACE_URL_ENCODED_OWNER_PASSWORD@postgres:5432/patchproof
PATCHPROOF_OIDC_ISSUER=https://identity.example.com/realms/patchproof
PATCHPROOF_OIDC_AUDIENCE=patchproof-api
PATCHPROOF_OIDC_JWKS_URL=https://identity.example.com/realms/patchproof/protocol/openid-connect/certs
PATCHPROOF_PUBLIC_ORIGIN=https://patchproof.example.com
PATCHPROOF_BACKEND_URL=http://api:8000
OIDC_CLIENT_ID=patchproof-dashboard
OIDC_CLIENT_SECRET=REPLACE_WITH_OIDC_CLIENT_SECRET
OIDC_COOKIE_SECRET=REPLACE_WITH_BASE64_32_BYTE_SECRET
PATCHPROOF_HOSTED_DEV=0
PATCHPROOF_CONCURRENCY=2
PATCHPROOF_LEASE_SECONDS=60
PATCHPROOF_HEARTBEAT_SECONDS=10
PATCHPROOF_MAX_ATTEMPTS=3
PATCHPROOF_TARGET_LIMIT=5
PATCHPROOF_MODEL_LIMIT=3
PATCHPROOF_MODEL_TIMEOUT=20
PATCHPROOF_MODEL_TOKENS=2048
PATCHPROOF_MODELS_PER_DAY=100
PATCHPROOF_SUBMISSIONS_PER_MINUTE=10
PATCHPROOF_TARGETS_PER_MINUTE=30
PATCHPROOF_PENDING_LIMIT=100
PATCHPROOF_CHALLENGE_SECONDS=900
PATCHPROOF_VERIFICATION_SECONDS=86400
