# Optional: only investigate uses these settings. Never commit real credentials.
OPENROUTER_API_KEY=
# Set to an OpenRouter model ID that supports tool calling.
OPENROUTER_MODEL=

# Local FastAPI backend and Next.js server must share this credential (32+ chars).
# Prefer: python scripts/configure_local.py (creates ignored .env.api).
PATCHPROOF_API_TOKEN=
# Optional server-only fixture exception. Disabled when empty.
# Example: http://127.0.0.1:8765 — literal loopback IP, exact scheme and port.
PATCHPROOF_FIXTURE_ORIGIN=
