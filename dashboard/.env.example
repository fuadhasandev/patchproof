# Server-only credential shared with FastAPI. Never use a NEXT_PUBLIC_ prefix.
# Prefer sourcing ../.env.api in the terminal before npm run dev.
PATCHPROOF_API_TOKEN=
NEXT_TELEMETRY_DISABLED=1

# Hosted deployment only: OAuth2 Proxy must be the only ingress.
PATCHPROOF_MODE=local
PATCHPROOF_PUBLIC_ORIGIN=https://patchproof.example.com
PATCHPROOF_BACKEND_URL=http://api:8000
